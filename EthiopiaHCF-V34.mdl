{UTF-8}
implied discontinuation rate[HTN]=
	discontinuation rate[HTN]*(2/(1+demand fulfilment ratio))*(relative essential medication availability\
		^(-strength of med availability on discontinuation[HTN])) ~~|
implied discontinuation rate[DIA]=
	discontinuation rate[DIA]*(2/(1+demand fulfilment ratio))*(relative essential medication availability\
		^(-strength of med availability on discontinuation[DIA]))
	~	1/Year
	~	https://www.desmos.com/calculator/tt8ub5p7aw
	|

demand fulfilment percent=
	demand fulfilment ratio*100
	~	Dmnl
	~		|

regional internal revenue=
	total internal revenue*facilities in Amhara
	~	Birr/Year
	~		|

strategy to increase provider capacity=
	STEP(provider number strategy strength*alpha, provider strategy start year )+1
	~	Dmnl
	~		|

strategy to increase enrollments=
	STEP(enrollment strategy strength*beta, enrollment strategy start year )+1
	~	Dmnl
	~		|

strategy to increase fee waivers=
	STEP(fee waiver strategy strength*beta, fee waiver strategy start year )+1
	~	Dmnl
	~		|

strategy to increase provider productivity=
	STEP(provider strategy strength*alpha, provider productivity strategy start year )
	~	Dmnl
	~		|

unutilized revenue strategy strength=
	0
	~	Dmnl [0,1]
	~		|

implied procurement responsiveness=
	strategy to increase demand responsiveness*procurement responsiveness
	~	Dmnl
	~	1 represents perfect tracking; 0 represents no response at all. 0.5: \
		partial realistic
	|

adjusted annual average RDF=
	unutilized internal revenue per facility+avg adjusted total revolving drug funds+((revenue from user fees\
		+reimbursements)*fraction allocated to RDF)
	~	Birr/(Year*facility)
	~		|

strategy to increase demand responsiveness=
	STEP(responsiveness strategy strength*beta, responsiveness strategy start year )+1
	~	Dmnl
	~		|

responsiveness strategy strength=
	0
	~	Dmnl [0,1]
	~		|

strategy to divert unutilized revenue=
	STEP(unutilized revenue strategy strength*beta, unutilized revenue strategy start year\
		 )
	~	Dmnl
	~		|

unutilized revenue strategy start year=
	2018
	~	Year [2010,?]
	~		|

implied medication restocking=
	base medication restocking rate*relative avg adjusted total revolving drug funds*(change in demand for medications\
		^(implied procurement responsiveness))*strategy to increase restocking
	~	1/Year
	~		|

responsiveness strategy start year=
	2018
	~	Year [2010,?]
	~		|

unutilized internal revenue per facility=
	unutilized internal revenue*strategy to divert unutilized revenue
	~	Birr/(Year*facility)
	~		|

implied enrollment rate=
	base enrollment rate*eff of perceived benefit on enrollment
	~	1/Year
	~		|

new enrollments=
	min(People in informal sector not enrolled to CBHI*implied enrollment rate*strategy to increase enrollments\
		,People in informal sector not enrolled to CBHI
	*strategy to increase enrollments/time to enroll)
	~	household/Year
	~	min(People in informal sector not enrolled to CBHI*implied enrollment rate*strategy \
		to increase enrollments,People in informal sector not enrolled to CBHI
		*strategy to increase enrollments/time to enroll)
	|

people screened for NCD[HTN]=
	max(NCD screen rate[HTN]*(Untreated NCD[HTN]+Population at risk of developing NCD[HTN\
		]),0) ~~|
people screened for NCD[DIA]=
	max(NCD screen rate[DIA]*(Untreated NCD[DIA]+Population at risk of developing NCD[DIA\
		]),0)
	~	person/Year
	~		|

productivity gap=
	target productivity-provider productivity
	~	Dmnl
	~		|

target productivity=
	0.8
	~	Dmnl
	~		|

NCD screen rate[HTN]=
	min(implied screening propensity[HTN]*eff of health coverage on screening[HTN]*demand fulfilment ratio\
		,1) ~~|
NCD screen rate[DIA]=
	min(implied screening propensity[DIA]*eff of health coverage on screening[DIA]*demand fulfilment ratio\
		,1)
	~	1/Year
	~		|

percent enrolled in insurance among eligible households=
	(CBHI beneficiaries+Fee waivered population with health coverage)/(CBHI beneficiaries\
		+People in informal sector not enrolled to CBHI+Fee waivered population with health coverage\
		)
	~	1
	~		|

reimbursement strategy strength=
	0
	~	Dmnl [0,1]
	~		|

target reimbursement=
	0.9
	~	Dmnl
	~		|

strategy to increase reimbursement=
	STEP(reimbursement strategy strength*beta, reimbursement strategy start year )
	~	Dmnl
	~		|

target gap=
	target reimbursement-implied CBHI reimbursement approval fraction
	~	1
	~		|

provider productivity=
	min(0.57+strategy to increase provider productivity,1)
	~	Dmnl
	~	"44% of clinical staff was not available on the day of the survey. Various reasons \
		were given for this. Amongst the clinical staff, 38% were absent because \
		of attendance to seminar sessions, 8% because of long-training, 25% were \
		on official travel and 20% were on leave. RCH clinic nurses were present \
		for 7 hours a day, but only worked productively for 57% of time present at \
		facility."
		
		https://link.springer.com/article/10.1186/1478-4491-10-3
	|

provider strategy strength=
	0
	~	Dmnl [0,1]
	~		|

provider productivity strategy start year=
	2018
	~	Year [2010,?]
	~		|

demand fulfilment ratio=
	min(1, ZIDZ(total provider minutes, total demand minutes))
	~	Dmnl
	~	min(1, ZIDZ(total NCD provider minutes, total NCD demand minutes))
		min(1, ZIDZ(total provider minutes, total demand minutes))
	|

p26=
	IF THEN ELSE( 2006<= Time :AND: Time<=2016, ZIDZ(ABS(p26 data-p26 sim),p26 data)*more weight on confidence data\
		, :NA:)
	~	Dmnl
	~		|

population cal weight=
	more weight on confidence data
	~	Dmnl
	~		|

access multiplier=
	(care capacity per capita / initial care capacity per capita)
	~	1
	~		|

Adjusted annual average revenue of facilities= INTEG (
	reimbursements+revenue from user fees-expenditures,
		initial average annual IR)
	~	Birr/facility
	~		|

total payoff=
	((
	IF THEN ELSE(p1=:NA:, 0 , p1 )+
	IF THEN ELSE(p2=:NA:, 0 , p2 )+
	IF THEN ELSE(p3=:NA:, 0 , p3 )+
	IF THEN ELSE(p4=:NA:, 0 , p4 )+
	IF THEN ELSE(p5=:NA:, 0 , p5 )+
	IF THEN ELSE(p6=:NA:, 0 , p6 )+
	IF THEN ELSE(p7=:NA:, 0 , p7 )+
	IF THEN ELSE(p8=:NA:, 0 , p8 )+
	IF THEN ELSE(p14=:NA:, 0 , p14 )+
	IF THEN ELSE(p15=:NA:, 0 , p15 )+
	IF THEN ELSE(p16=:NA:, 0 , p16 )+
	IF THEN ELSE(p17=:NA:, 0 , p17 )+
	IF THEN ELSE(p18=:NA:, 0 , p18 )+
	IF THEN ELSE(p19=:NA:, 0 , p19 )+
	
	IF THEN ELSE(p21=:NA:, 0 , p21 )+
	IF THEN ELSE(p22=:NA:, 0 , p22 )+
	IF THEN ELSE(p24=:NA:, 0 , p23 )+
	IF THEN ELSE(p24=:NA:, 0 , p24 )+
	IF THEN ELSE(p25=:NA:, 0 , p25 )+
	IF THEN ELSE(p26=:NA:, 0 , p26 )+
	IF THEN ELSE(p27=:NA:, 0 , p27 )+
	IF THEN ELSE(p28=:NA:, 0 , p28 )+
	IF THEN ELSE(p29=:NA:, 0 , p29 )+
	IF THEN ELSE(p30=:NA:, 0 , p30 )+
	IF THEN ELSE(p31=:NA:, 0 , p31 )+
	IF THEN ELSE(p31=:NA:, 0 , p32 )+
	IF THEN ELSE(p31=:NA:, 0 , p33 )
	)*(partial cal switch))
	+
	(
	IF THEN ELSE(p9=:NA:, 0 , p9 )+
	IF THEN ELSE(p10=:NA:, 0 , p10 )+
	IF THEN ELSE(p11=:NA:, 0 , p11 )+
	IF THEN ELSE(p12=:NA:, 0 , p12 )+
	IF THEN ELSE(p13=:NA:, 0 , p13 ))*(1-partial cal switch)
	~	Dmnl
	~		|

implied CBHI reimbursement approval fraction=
	min(CBHI reimbursement approval fraction DATA+strategy to increase reimbursement,1)
	~	Dmnl
	~		|

relative essential medication availability=
	ZIDZ(essential medication availability, initial essential medicine availability)
	~	Dmnl
	~		|

implied tx enrollment frac post screening[HTN]=
	base tx enrollment rate post screening[HTN]*demand fulfilment ratio*(relative essential medication availability\
		^(strength of med availability on enrollment[HTN])) ~~|
implied tx enrollment frac post screening[DIA]=
	base tx enrollment rate post screening[DIA]*demand fulfilment ratio*(relative essential medication availability\
		^(strength of med availability on enrollment[DIA]))
	~	Dmnl
	~		|

essential medication availability=
	Facilities with medication/(Facilities with medication+Facilities without medication\
		)
	~	Dmnl
	~		|

demand minutes for NCD screening=
	NCD screening related service utilization * minutes per visit
	~	minute/Year
	~		|

new enrollment into care[HTN]=
	min( people screened positive for NCD[HTN]*implied tx enrollment frac post screening\
		[HTN],
		     Untreated NCD[HTN]/transition time ) ~~|
new enrollment into care[DIA]=
	min( people screened positive for NCD[DIA]*implied tx enrollment frac post screening\
		[DIA], 
	Untreated NCD[DIA]/transition time )
	~	person/Year
	~	min( people screened positive for NCD[HTN]*base tx enrollment rate post \
		screening[HTN]*(2*demand fulfilment ratio/(1+demand fulfilment ratio
		)),
			     Untreated NCD[HTN]/transition time )
	|

strength of med availability on enrollment[HTN]=
	1 ~~|
strength of med availability on enrollment[DIA]=
	1
	~	Dmnl
	~		|

strength of med availability on discontinuation[HTN]=
	1 ~~|
strength of med availability on discontinuation[DIA]=
	1
	~	Dmnl
	~		|

