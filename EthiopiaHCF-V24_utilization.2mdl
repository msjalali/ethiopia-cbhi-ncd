Untreated NCD[HTN]= INTEG (
	developing NCD[HTN]-new enrollment into care[HTN]-death of untreated NCD patients[HTN\
		]+discontinuation from care[HTN],
		initial undiagnosed uncontrolled NCD[HTN]) ~~|
Untreated NCD[DIA]= INTEG (
	developing NCD[DIA]-new enrollment into care[DIA]-death of untreated NCD patients[DIA\
		]+discontinuation from care[DIA],
		initial undiagnosed uncontrolled NCD[DIA])
