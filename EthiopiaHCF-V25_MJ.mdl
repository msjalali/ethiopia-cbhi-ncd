{UTF-8}
p4=
	IF THEN ELSE( Time>=2010-1:AND:Time <=2010+1 ,  ZIDZ(ABS(p4 data-p4 sim),p4 data*2*TIME STEP\
		/OneYear)
	, :NA:)
	~	Dmnl
	~	If data are point estimates(annual values), we need to divide by TIME STEP \
		to give comparable weight in payoff (due to time series data contributing \
		to payoff every TIME STEP); otherwise priors will be under-weighted \
		proportional to TIME STEP.
	|

OneYear=
	1
	~	Year
	~		|

demand minutes for NCD=
	total NCD care demand pop * minutes per NCD patient year
	~	minute/Year
	~		|

demand minutes for NCD screening=
	NCD screening related service utilization * minutes per screen
	~	minute/Year
	~		|

demand minutes for non NCD=
	non NCD visits * minutes per non NCD visit
	~	minute/Year
	~		|

demand fullfilment ratio=
	min(1, ZIDZ(total provider minutes, total demand minutes))
	~	Dmnl
	~		|

initial tot demand min ratio=
	0.5
	~	Dmnl
	~		|

initial total demand minutes=
	total provider minutes*initial tot demand min ratio
	~	minute/Year
	~		|

people screened for NCD[HTN]=
	max(NCD screen rate[HTN]*(Untreated NCD[HTN]+Population at risk of developing NCD[HTN\
		]),0) * demand fullfilment ratio ~~|
people screened for NCD[DIA]=
	max(NCD screen rate[DIA]*(Untreated NCD[DIA]+Population at risk of developing NCD[DIA\
		]),0) * demand fullfilment ratio
	~	person/Year
	~		|

capacity utilization=
	ZIDZ(total demand minutes, total provider minutes)
	~	Dmnl
	~		|

non NCD visits=
	total visits - active patient NCD related service utilization - NCD screening related service utilization
	~	person/Year
	~		|

relative NCD care service availability=
	relative essential medicine availability* demand fullfilment ratio
	~	1
	~		|

minutes per non NCD visit=
	minutes per visit
	~	minute/patient
	~		|

total demand minutes=
	DELAY1I(	demand minutes for non NCD
		+ demand minutes for NCD
		+ demand minutes for NCD screening,
		TIME STEP, initial total demand minutes)
	~	minute/Year
	~		|

total provider minutes=
	Total Providers*annual clinical minutes per provider
	~	minute/Year
	~		|

minutes per screen=
	5
	~	minute/patient
	~		|

minutes per visit=
	10
	~	minute/patient
	~		|

annual clinical minutes per provider=
	79200
	~	minute/(provider*Year)
	~	220 working days × 6 clinical hours × 60 min
	|

minutes per NCD patient year=
	annual health service utilization per NCD patient*minutes per visit
	~	minute/patient/Year
	~	 2 visits (every 6 months) × 20 min/visit =40
	|

access multiplier=
	(care capacity per capita / initial care capacity per capita) ^ strength access on utilization
	~	1
	~		|

eff of coverage on service utilization=
	1.35
	~	1
	~	Community-based health insurance (CBHI) enrolees experience a 30 to 41 \
		percent increase in health care utilization (Mebratie et al. 2019) \
		(10.1016/j.socscimed.2018.11.003). We use an average of 35%
	|

other health service utilization=
	reference utilization per capita*access multiplier
	~	1/Year
	~		|

reference utilization per capita=
	0.1
	~	1/Year
	~		|

strength access on utilization=
	1
	~	Dmnl
	~		|

initial care capacity per capita= INITIAL(
	care capacity per capita)
	~	provider/person
	~		|

new utilization for HTN screen=
	people screened for NCD[HTN]
	~	person/Year
	~		|

initial visits= INITIAL(
	DATA Amhara total population 30 yo plus*DATA health service utilization per capita)
	~	person/Year
	~		|

p30 data=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, DATA positive result for screened HTN, :NA:\
		)
	~	person/Year
	~		|

lagged visits=
	DELAY1I(total visits, TIME STEP, initial visits)
	~	person/Year
	~		|

p31 data=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, DATA positive result for screened DIA , \
		:NA:)
	~	person/Year
	~		|

new utilization for DIA screen=
	people screened for NCD[DIA]
	~	person/Year
	~		|

initial perceived benefit= INITIAL(
	percent enrolled among eligible households)
	~	Dmnl
	~		|

percent enrolled among eligible households=
	CBHI beneficiaries/(CBHI beneficiaries+People in informal sector not enrolled to CBHI\
		)
	~	Dmnl
	~		|

relative benefit=
	ZIDZ(percent enrolled among eligible households,initial perceived benefit)
	~	1
	~		|

adjusted subsidies=
	adjusted total CBHI collected fees*subsidy fraction
	~	Birr/Year
	~		|

care capacity per capita=
	Total Providers/DATA Amhara total population 30 yo plus
	~	provider/person
	~		|

new enrollment into care[HTN]=
	min( people screened positive for NCD[HTN]*base tx enrollment rate post screening[HTN\
		]*demand fullfilment ratio,
		     Untreated NCD[HTN]/transition time ) ~~|
new enrollment into care[DIA]=
	min( people screened positive for NCD[DIA]*base tx enrollment rate post screening[DIA\
		]*demand fullfilment ratio, Untreated NCD[DIA]/transition time )
	~	person/Year
	~		|

strategy to increase screen=
	STEP(screen strategy strength*beta, screen strategy start year )+1
	~	Dmnl
	~		|

alpha=
	1
	~	Dmnl
	~		|

strategy to increase enrollments=
	STEP(enrollment strategy strength*alpha, enrollment strategy start year )+1
	~	Dmnl
	~		|

strategy to increase provider capacity=
	STEP(provider strategy strength*beta, provider strategy start year )+1
	~	Dmnl
	~		|

strategy to increase reimbursement=
	STEP(reimbursement strategy strength*beta, reimbursement strategy start year )+1
	~	Dmnl
	~		|

strategy to decrease reimbursement delay=
	1-STEP(delay reduction strategy strength*beta, delay reduction strategy start year )
	~	Dmnl
	~		|

beta=
	1
	~	Dmnl
	~		|

strategy to increase restocking=
	STEP(restock strategy strength*beta, restock strategy start year )+1
	~	Dmnl
	~		|

p31=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, ZIDZ(ABS(p31 data-p31 sim)*switch to set zero\
		,p31 data
	), :NA:)
	~	Dmnl
	~		|

p30=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, ZIDZ(ABS(p30 data-p30 sim)*switch to set zero\
		,p30 data
	), :NA:)
	~	Dmnl
	~		|

p31 sim=
	total diagnosed DIA patients in tx 1
	~	person/Year
	~		|

total payoff=
	((
	IF THEN ELSE(p1=:NA:, 0 , p1 )+
	IF THEN ELSE(p2=:NA:, 0 , p2 )+
	IF THEN ELSE(p3=:NA:, 0 , p3 )+
	IF THEN ELSE(p4=:NA:, 0 , p4 )+
	IF THEN ELSE(p5=:NA:, 0 , p5 )+
	IF THEN ELSE(p6=:NA:, 0 , p6 )+
	IF THEN ELSE(p7=:NA:, 0 , p7 )+
	IF THEN ELSE(p8=:NA:, 0 , p8 )+
	IF THEN ELSE(p14=:NA:, 0 , p14 )+
	IF THEN ELSE(p15=:NA:, 0 , p15 )+
	IF THEN ELSE(p16=:NA:, 0 , p16 )+
	IF THEN ELSE(p17=:NA:, 0 , p17 )+
	IF THEN ELSE(p18=:NA:, 0 , p18 )+
	IF THEN ELSE(p19=:NA:, 0 , p19 )+
	IF THEN ELSE(p20=:NA:, 0 , p20 )+
	IF THEN ELSE(p21=:NA:, 0 , p21 )+
	IF THEN ELSE(p22=:NA:, 0 , p22 )+
	IF THEN ELSE(p23=:NA:, 0 , p23 )+
	IF THEN ELSE(p24=:NA:, 0 , p24 )+
	IF THEN ELSE(p25=:NA:, 0 , p25 )+
	IF THEN ELSE(p26=:NA:, 0 , p26 )+
	IF THEN ELSE(p27=:NA:, 0 , p27 )+
	IF THEN ELSE(p28=:NA:, 0 , p28 )+
	IF THEN ELSE(p29=:NA:, 0 , p29 )+
	IF THEN ELSE(p30=:NA:, 0 , p30 )+
	IF THEN ELSE(p31=:NA:, 0 , p31 )
	)*(partial cal switch))
	+
	(
	IF THEN ELSE(p9=:NA:, 0 , p9 )+
	IF THEN ELSE(p10=:NA:, 0 , p10 )+
	IF THEN ELSE(p11=:NA:, 0 , p11 )+
	IF THEN ELSE(p12=:NA:, 0 , p12 )+
	IF THEN ELSE(p13=:NA:, 0 , p13 ))*(1-partial cal switch)
	~	Dmnl
	~		|

total diagnosed HTN patients in tx 1=
	people screened positive for NCD[HTN]
	~	person/Year
	~		|

total diagnosed DIA patients in tx 1=
	people screened positive for NCD[DIA]
	~	person/Year
	~		|

p30 sim=
	total diagnosed HTN patients in tx 1
	~	person/Year
	~		|

implied CBHI reimbursement approval fraction=
	min(CBHI reimbursement approval fraction*strategy to increase reimbursement,1)
	~	Dmnl
	~		|

screen strategy start year=
	2018
	~	Year [2010,?]
	~		|

screen strategy strength=
	0
	~	Dmnl [0,1]
	~		|

implied medication restocking=
	base medication restocking rate*relative avg adjusted total revolving drug funds*strategy to increase restocking
	~	1/Year
	~		|

change in provider availability=
	(provider gap/max provider per facility)*implied provider adjustment rate
	~	provider/Year
	~		|

p29 sim=
	adjusted subsidies
	~	Birr/Year
	~		|

implied provider adjustment rate=
	provider adjustment rate*strategy to increase provider capacity
	~	provider/Year
	~		|

implied screen rate[HTN]=
	base NCD screen rate[HTN]*strategy to increase screen ~~|
implied screen rate[DIA]=
	base NCD screen rate[DIA]*strategy to increase screen
	~	1/Year
	~		|

DATA general subsidies:INTERPOLATE:
	~	Birr/Year
	~		|

p5=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, ZIDZ(ABS(p5 data-p5 sim),p5 data
	), :NA:)
	~	Dmnl
	~		|

p5 data=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, DATA early loss to follow up HTN , :NA:)
	~	person/Year
	~		|

early discont[HTN]=
	fraction discont early*discontinuation from care[HTN] ~~|
early discont[DIA]=
	discontinuation from care[DIA]*fraction discont early
	~	person/Year
	~		|

subsidy fraction=
	0.1
	~	Dmnl
	~		|

p6 data=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, DATA early loss to follow up DIA  , :NA:\
		)
	~	person/Year
	~		|

restock strategy start year=
	2018
	~	Year [2010,?]
	~		|

restock strategy strength=
	0
	~	Dmnl [0,1]
	~		|

p6 sim=
	total diagnosed DIA patients in tx 0
	~	person/Year
	~		|

DATA adjusted subsidies=
	DATA general subsidies*DATA inflation conversion multiplier for 2017 birr value
	~	Birr/Year
	~		|

reimbursement strategy start year=
	2018
	~	Year [2010,?]
	~		|

CBHI reimbursements approved=
	min(reimbursement requests from CBHIs*implied CBHI reimbursement approval fraction, \
		CBHI revenue/revenue utilization time)
	~	Birr/Year
	~		|

reimbursement strategy strength=
	0
	~	Dmnl [0,1]
	~		|

provider strategy start year=
	2018
	~	Year [2010,?]
	~		|

p29=
	IF THEN ELSE( 2009<= Time :AND: Time<=2016, ZIDZ(ABS(p29 data-p29 sim),p29 data), :NA:\
		)
	~	Dmnl
	~		|

p29 data=
	IF THEN ELSE( 2009<= Time :AND: Time<=2016, DATA adjusted subsidies , :NA:)
	~	Birr/Year
	~		|

collected fees and subsidies=
	adjusted total CBHI collected fees+adjusted subsidies
	~	Birr/Year
	~		|

provider strategy strength=
	0
	~	Dmnl [0,1]
	~		|

total diagnosed HTN patients in tx 0=
	early discont[HTN]
	~	person/Year
	~		|

p6=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, ZIDZ(ABS(p6 data-p6 sim),p6 data
	), :NA:)
	~	Dmnl
	~		|

NCD screen rate[HTN]=
	implied screen rate[HTN]*eff of health coverage on screening[HTN] ~~|
NCD screen rate[DIA]=
	implied screen rate[DIA]*eff of health coverage on screening[DIA]
	~	1/Year
	~		|

fraction discont early=
	0.8
	~	Dmnl
	~		|

total diagnosed DIA patients in tx 0=
	early discont[DIA]
	~	person/Year
	~		|

p5 sim=
	total diagnosed HTN patients in tx 0
	~	person/Year
	~		|

implied positive screening rate[HTN]=
	base positive NCD fraction for screened people[HTN]*relative untreated NCD[HTN] ~~|
implied positive screening rate[DIA]=
	base positive NCD fraction for screened people[DIA]*relative untreated NCD[DIA]
	~	Dmnl
	~		|

fraction not in treatment[HTN]=
	1-Fraction in treatment[HTN] ~~|
fraction not in treatment[DIA]=
	1-Fraction in treatment[DIA]
	~	Dmnl
	~		|

Prevalence[HTN]=
	(Untreated NCD[HTN]+Treated NCD[HTN])/total adult population 1 ~~|
Prevalence[DIA]=
	(Untreated NCD[DIA]+Treated NCD[DIA])/total adult population 2
	~	Dmnl
	~		|

relative untreated NCD[HTN]=
	fraction not in treatment[HTN]/initial fraction not in treatment[HTN] ~~|
relative untreated NCD[DIA]=
	fraction not in treatment[DIA]/initial fraction not in treatment[DIA]
	~	Dmnl
	~		|

initial fraction not in treatment[HTN]= INITIAL(
	fraction not in treatment[HTN]) ~~|
initial fraction not in treatment[DIA]= INITIAL(
	fraction not in treatment[DIA])
	~	Dmnl
	~		|

Fraction in treatment[HTN]=
	Treated NCD[HTN]/(Untreated NCD[HTN]+Treated NCD[HTN]) ~~|
Fraction in treatment[DIA]=
	Treated NCD[DIA]/(Untreated NCD[DIA]+Treated NCD[DIA])
	~	Dmnl
	~	HTN: https://pmc.ncbi.nlm.nih.gov/articles/PMC6288930/
	|

people screened positive for NCD[HTN]=
	people screened for NCD[HTN]*implied positive screening rate[HTN] ~~|
people screened positive for NCD[DIA]=
	people screened for NCD[DIA]*implied positive screening rate[DIA]
	~	person/Year
	~		|

total NCD care demand pop=
	SUM(Treated NCD[NCD!])
	~	person
	~		|

dropout=
	max(min(CBHI beneficiaries*dropout rate,CBHI beneficiaries/change time),0)
	~	household/Year
	~		|

base positive NCD fraction for screened people[HTN]=
	0.2 ~~|
base positive NCD fraction for screened people[DIA]=
	0.1
	~	Dmnl
	~		|

DATA tx enrollment rate post screening[HTN]=
	DATA newly enrolled HTN/DATA positive result for screened HTN ~~|
DATA tx enrollment rate post screening[DIA]=
	DATA newly enrolled DIA/DATA positive result for screened DIA
	~	Dmnl
	~		|

population cal weight=
	5
	~	Dmnl
	~		|

p15=
	IF THEN ELSE( 2006<= Time :AND: Time<=2017, ZIDZ(ABS(p15 data-p15 sim),p15 data)*population cal weight\
		, :NA:)
	~	Dmnl
	~		|

base tx enrollment rate post screening[HTN]=
	0.5 ~~|
base tx enrollment rate post screening[DIA]=
	0.5
	~	Dmnl
	~		|

p16=
	IF THEN ELSE( 2006<= Time :AND: Time<=2017, ZIDZ(ABS(p16 data-p16 sim),p16 data)*population cal weight\
		, :NA:)
	~	Dmnl
	~		|

death of at risk population[HTN]=
	min(base death rate*Population at risk of developing NCD[HTN],Population at risk of developing NCD\
		[HTN]/ transition time) ~~|
death of at risk population[DIA]=
	min(base death rate*Population at risk of developing NCD[DIA],Population at risk of developing NCD\
		[DIA]/ transition time)
	~	person/Year
	~		|

total adult population 1=
	Treated NCD[HTN]+Population at risk of developing NCD[HTN]+Untreated NCD[HTN]
	~	person
	~		|

total adult population 2=
	Treated NCD[DIA]+Population at risk of developing NCD[DIA]+Untreated NCD[DIA]
	~	person
	~		|

death rate for untreated NCD[HTN]=
	base death rate*relative death risk for NCD[HTN] ~~|
death rate for untreated NCD[DIA]=
	base death rate*relative death risk for NCD[DIA]
	~	1/Year [0,0.01,0.001]
	~		|

total deaths=
	death of at risk population[HTN]+death of at risk population[DIA]+death among undiag NCD patients DIA\
		+death among undiag NCD patients HTN+total death among NCD patients DIA+total death among NCD patients HTN
	~	person/Year
	~		|

developing NCD[HTN]=
	min(Population at risk of developing NCD[HTN]*NCD development rate[HTN], Population at risk of developing NCD\
		[HTN]/transition time) ~~|
developing NCD[DIA]=
	min(Population at risk of developing NCD[DIA]*NCD development rate[DIA],Population at risk of developing NCD\
		[DIA]/transition time)
	~	person/Year
	~		|

Population at risk of developing NCD[HTN]= INTEG (
	new people joining at risk population-death of at risk population[HTN]- developing NCD\
		[HTN],
		initial population at risk of developing NCD[HTN]) ~~|
Population at risk of developing NCD[DIA]= INTEG (
	new people joining at risk population-death of at risk population[DIA]-developing NCD\
		[DIA],
		initial population at risk of developing NCD[DIA])
	~	person
	~		|

partial cal switch=
	1
	~	Dmnl
	~		|

net enrollment rate in 2007=
	0.53
	~	Dmnl
	~		|

CBHI beneficiaries= INTEG (
	new enrollments-dropout,
		initial CBHI beneficiaries)
	~	household
	~		|

initial CBHI beneficiaries=
	net enrollment rate in 2007*DATA CBHI targeted households
	~	household
	~		|

initial CBHI eligible not enrolled=
	(1-net enrollment rate in 2007)*DATA CBHI targeted households
	~	household
	~		|

People in informal sector not enrolled to CBHI= INTEG (
	dropout+eligible population adjustment+fee waiver enrollment change-fee waivered insurance coverage\
		-new enrollments,
		initial CBHI eligible not enrolled)
	~	household
	~		|

household size adj for fees=
	1
	~	Dmnl
	~		|

adjusted total CBHI collected fees=
	DATA adjusted membership cost per household*CBHI beneficiaries*household size adj for fees
	~	Birr/Year
	~		|

weight=
	5
	~	Dmnl
	~		|

p11=
	IF THEN ELSE( 2009<= Time :AND: Time<=2016, ZIDZ(ABS(p11 data-p11 sim),p11 data)*weight\
		, :NA:)
	~	Dmnl
	~		|

CBHI or fee waivered patient visits=
	insured service utilization per capita*adult pop with coverage
	~	person/Year
	~		|

adult pop with coverage=
	DATA Amhara total population 30 yo plus*frac adult of pop with coverage
	~	person
	~		|

uninsured service utilization per capita=
	other health service utilization+NCD related service utilization per capita
	~	1/Year
	~		|

insured service utilization per capita=
	(other health service utilization+NCD related service utilization per capita)*eff of coverage on service utilization
	~	1/Year
	~		|

NCD related service utilization=
	(active patient NCD related service utilization+NCD screening related service utilization\
		)
	~	person/Year
	~		|

NCD related service utilization per capita=
	NCD related service utilization/DATA Amhara total population 30 yo plus
	~	1/Year
	~		|

total service utilization per capita=
	total visits/DATA Amhara total population 30 yo plus
	~	1/Year
	~		|

uninsured patient visits=
	(uninsured service utilization per capita)*DATA Amhara total population 30 yo plus
	*(1-frac adult of pop with coverage)
	~	person/Year
	~		|

Adjusted annual average revenue of facilities= INTEG (
	other public funding per facility+reimbursements+revenue from user fees-expenditures\
		,
		initial average annual IR)
	~	Birr/facility
	~		|

other public funding per facility=
	other public funding rate/facilities in Amhara
	~	Birr/(Year*facility)
	~		|

p20 sim=
	other public funding per facility
	~	Birr/(Year*facility)
	~		|

CBHI paid=
	DELAY1(CBHI reimbursements approved, implied delay)
	~	Birr/Year
	~		|

implied eligible households not enrolled=
	DATA CBHI targeted households-(CBHI beneficiaries+Fee waivered population with health coverage\
		)
	~	household
	~		|

relative avg adjusted total revolving drug funds=
	adjusted annual average RDF/initial avg adjusted total revolving drug funds
	~	Dmnl
	~		|

initial avg adjusted total revolving drug funds= INITIAL(
	adjusted annual average RDF)
	~	Birr/(Year*facility)
	~		|

initial facilities with medication=
	initial essential medicine availability*facilities in Amhara
	~	facility
	~		|

initial facilities without medication=
	(1-initial essential medicine availability)*facilities in Amhara
	~	facility
	~		|

relative essential medicine availability=
	ZIDZ(essential medication availability,initial essential medicine availability)
	~	Dmnl
	~		|

expenditures=
	min((total visits*base average care cost per person)/facilities in Amhara, Adjusted annual average revenue of facilities
	/revenue utilization time)
	~	Birr/(Year*facility)
	~		|

restocking rate=
	min(Facilities without medication*implied medication restocking,Facilities without medication\
		/facility stock adjustment time)
	~	facility/Year
	~		|

base average care cost per person=
	3
	~	Birr/person
	~		|

facility stock adjustment time=
	1
	~	Year
	~		|

stock out rate=
	min(Facilities with medication*implied medication utilization rate,Facilities with medication\
		/facility stock adjustment time)
	~	facility/Year
	~		|

p28 sim=
	essential medication availability
	~	Dmnl
	~		|

essential medication availability=
	Facilities with medication/(Facilities with medication+Facilities without medication\
		)
	~	Dmnl
	~		|

Facilities with medication= INTEG (
	restocking rate-stock out rate,
		initial facilities with medication)
	~	facility
	~		|

Facilities without medication= INTEG (
	stock out rate-restocking rate,
		initial facilities without medication)
	~	facility
	~		|

reimbursement requests from CBHIs=
	CBHI or fee waivered patient visits*base average fee per person
	~	Birr/Year
	~		|

adjusted annual average RDF=
	avg adjusted total revolving drug funds+(revenue from user fees+reimbursements)*fraction allocated to RDF
	~	Birr/(Year*facility)
	~		|

fraction allocated to RDF=
	0.6
	~	Dmnl
	~		|

p26 sim=
	total service utilization per capita
	~	1/Year
	~		|

avg adjusted total revolving drug funds=
	DATA adjusted total revolving drug funds/facilities in Amhara
	~	Birr/(Year*facility)
	~		|

revenue from user fees=
	(uninsured patient visits*base average fee per person)/facilities in Amhara
	~	Birr/(Year*facility)
	~		|

total visits=
	CBHI or fee waivered patient visits+uninsured patient visits
	~	person/Year
	~		|

p3 data=
	IF THEN ELSE( Time>=2007-1 :AND: Time <=2007+1, Point DATA Prevalence HTN, :NA:)
	~	1
	~		|

p4 data=
	IF THEN ELSE( Time>= 2010-1:AND: Time <=2010+1, Point DATA Prevalance DIA
	, :NA:)
	~	1
	~		|

discontinuation from care[HTN]=
	min(Treated NCD[HTN]*implied discontinuation rate[HTN],Treated NCD
	[HTN]/transition time) ~~|
discontinuation from care[DIA]=
	min(Treated NCD[DIA]*implied discontinuation rate[DIA],Treated NCD
	[DIA]/transition time)
	~	person/Year
	~		|

implied discontinuation rate[HTN]=
